{
  "name": "nodejs-mysql-server-ts",
  "version": "1.0.0",
  "description": "A Node.js server with MySQL using TypeScript",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "stop": "lsof -ti :8080 | xargs kill -9 || true",
    "start": "node dist/index.js",
    "dev": "lsof -ti :8080 | xargs kill -9 && nodemon --ext ts --exec ts-node src/index.ts"
  },
  "dependencies": {
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "lodash": "^4.17.21",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.2.0",
    "nodemon": "^3.1.9"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.15",
    "@types/lodash": "^4.17.16",
    "@types/multer": "^1.4.12",
    "@types/node": "^18.0.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
